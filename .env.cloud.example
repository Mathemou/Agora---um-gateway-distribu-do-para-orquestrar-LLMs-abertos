# Ágora na nuvem (docker-compose.cloud.yml). Copie para .env na VM e preencha.
# Nunca faça commit do .env.

# Endereço público. Sem domínio próprio, use o IP da VM com hífens + .sslip.io
# (ex.: IP 129.146.10.20 -> 129-146-10-20.sslip.io); o Caddy tira o certificado sozinho.
DOMAIN=

# Groq (IA principal): https://console.groq.com/keys
GROQ_API_KEY=
MODEL_GROQ=qwen/qwen3.8-27b

# OpenCode Go (reserva, assinatura do Yan)
OPENCODE_API_KEY=
MODEL_OPENCODE=glm-5.3-flash

# Token que protege a API (POST /v1/chat e /v1/balancer). Gere com: openssl rand -hex 24
# Os clientes de linha de comando usam a mesma variável: export AGORA_API_TOKEN=...
AGORA_API_TOKEN=

# Quem joga como IA, a reserva (precisa ser diferente) e o Mestre.
GAME_IMPOSTOR_DOMAIN=impostor-groq
GAME_IMPOSTOR_FALLBACK=impostor-opencode
GAME_MASTER_DOMAIN=mestre-groq
GAME_MIN_PLAYERS=3
GAME_DISCUSSION_S=150
QUEUE_POLICY=priority
