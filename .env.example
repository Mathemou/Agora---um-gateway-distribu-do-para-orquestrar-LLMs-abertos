# Copie para .env e ajuste à sua máquina.

# Modelos (os menores da família Qwen 2.5, ~400 MB cada, rodam bem em CPU)
MODEL_REDES=qwen2.5:0.5b
MODEL_PROG=qwen2.5-coder:0.5b

# Recursos por nó de inferência. Com 2 nós: 2 × 3g + 0,5g do gateway ≈ 6,5 GB.
NODE_MEM_LIMIT=3g
NODE_CPUS=2

# Requisições simultâneas por nó (OLLAMA_NUM_PARALLEL = limite do gateway)
NODE_PARALLEL=2

# Fixe a versão do Ollama para o experimento ser reproduzível (ex.: ollama/ollama:0.12.6)
OLLAMA_IMAGE=ollama/ollama:latest
