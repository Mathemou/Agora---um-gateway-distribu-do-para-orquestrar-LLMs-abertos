# Copie para .env e ajuste à sua máquina.

# Modelos. A IA impostora usa o maior que a máquina aguentar; o Mestre só faz
# perguntas curtas, então o menor basta.
#   qwen2.5:7b ≈ 4,7 GB (melhor, lento em CPU) · qwen2.5:3b ≈ 1,9 GB (padrão)
#   qwen2.5:1.5b ≈ 1 GB · qwen2.5:0.5b ≈ 400 MB
MODEL_IMPOSTOR=qwen2.5:3b
MODEL_MESTRE=qwen2.5:0.5b

# Recursos. O nó da IA impostora tem limites próprios (precisa de mais CPU).
# Padrão: 4g (impostor) + 3g (mestre) + 0,5g (gateway) ≈ 7,5 GB.
IMPOSTOR_CPUS=4
IMPOSTOR_MEM_LIMIT=4g
NODE_MEM_LIMIT=3g
NODE_CPUS=2

# Requisições simultâneas por nó (OLLAMA_NUM_PARALLEL = limite do gateway)
NODE_PARALLEL=2

# Jogo: participantes mínimos (contando a IA) e duração padrão da discussão.
# GAME_MIN_PLAYERS=2 deixa jogar sozinho contra a IA (bom para testar).
GAME_MIN_PLAYERS=3
GAME_DISCUSSION_S=150

# IA pelo Groq (opcional, plano gratuito): modelos abertos grandes na nuvem.
# Crie a chave em https://console.groq.com/keys. Nunca faça commit do .env.
GROQ_API_KEY=
# qwen/qwen3.8-27b (rápido, responde direto) ou openai/gpt-oss-120b (mais esperto, mais lento)
MODEL_GROQ=qwen/qwen3.8-27b
# Quem é a IA por padrão: impostor (local), impostor-groq ou impostor-claude
# (o anfitrião também escolhe por sala, em "Opções da sala")
# Mestre: mestre (local) ou mestre-groq
GAME_MASTER_DOMAIN=mestre

# IA pelo Claude (opcional). Com a chave, o anfitrião pode escolher
# "Claude (API)" como A Coisa ao criar a sala. Crie a chave em https://platform.claude.com
# Nunca faça commit do .env (ele já está no .gitignore).
ANTHROPIC_API_KEY=
MODEL_CLAUDE=claude-haiku-5-5
# Quem é A Coisa por padrão: impostor (local) ou impostor-claude
GAME_IMPOSTOR_DOMAIN=impostor

# Personalidade da IA: vazio = gira a roda a cada partida. Opções: esportista, otaku,
# patricinha, hetero_top, gay_afeminado, mae, professor, engracadinho
GAME_AI_PERSONA=

# Fixe a versão do Ollama para o experimento ser reproduzível (ex.: ollama/ollama:0.12.6)
OLLAMA_IMAGE=ollama/ollama:latest
